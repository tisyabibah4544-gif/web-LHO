  var cat,fb;
  if(s>=90){cat='Sangat Baik';fb='Luar biasa! Kamu sudah memahami topik, gagasan utama, gagasan penjelas, dan kalimat utama dengan sangat baik. Untuk menantang dirimu, coba baca teks observasi lain dan tentukan keempat unsur itu sendiri.'}
  else if(s>=80){cat='Baik';fb='Pemahamanmu sudah baik. Periksa kembali soal yang masih keliru pada rekap di sebelah kiri, lalu baca ulang misi yang berkaitan agar pemahamanmu semakin mantap.'}
  else if(s>=70){cat='Cukup';fb='Kamu sudah menguasai sebagian besar materi. Lihat penguasaan per materi di bawah ini, ulangi misi yang masih terasa sulit, lalu coba kuis sekali lagi.'}
  else{cat='Perlu Belajar Kembali';fb='Tidak apa-apa, memahami struktur teks memang butuh latihan. Baca ulang materi pada setiap misi, perhatikan contoh dan alasan jawabannya, lalu coba kuis lagi. Kamu pasti bisa meningkat.'}
  $('#rCat').textContent=cat;$('#rFb').textContent=fb;
  $('#rDots').innerHTML=Q.map(function(d,i){var y=quiz.answers[i]===d.a;return '<span class="'+(y?'y':'n')+'" title="Soal '+(i+1)+(y?' benar':' salah')+'">'+(i+1)+(y?'✓':'✕')+'</span>'}).join('');
  var cats={};Q.forEach(function(d,i){var c=cats[d.c]||(cats[d.c]={n:0,r:0,m:d.m});c.n++;if(quiz.answers[i]===d.a)c.r++});
  $('#rSkills').innerHTML=Object.keys(cats).map(function(k){var c=cats[k];
    return '<div class="skill"><span><b>'+k+'</b>: '+c.r+' dari '+c.n+' benar</span>'+(c.r<c.n?'<button class="btn alt sm" data-go="'+c.m+'" type="button">Pelajari lagi</button>':'<span class="badge">Tuntas</span>')+'</div>'}).join('');
}

renderSteps();
show(location.hash.slice(1)||'beranda');
})();
</script>
