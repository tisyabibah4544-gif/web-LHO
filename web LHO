<script>
(function(){
'use strict';
var PAGES=['beranda','petunjuk','tujuan','misi-1','misi-2','misi-3','misi-4','misi-5','evaluasi','hasil'];
var STEPS=[['misi-1','Misi 1','1'],['misi-2','Misi 2','2'],['misi-3','Misi 3','3'],['misi-4','Misi 4','4'],['misi-5','Misi 5','5'],['evaluasi','Evaluasi','✎']];
var done={'misi-1':false,'misi-2':false,'misi-3':false,'misi-4':false,'misi-5':false};
var quiz={started:false,i:0,answers:[],finished:false};
var cur='beranda';
var $=function(s,r){return (r||document).querySelector(s)};
var MSG_OK='Hebat! Jawabanmu tepat. Kamu berhasil memahami materi ini.';
var MSG_NO='Belum tepat. Yuk, perhatikan kembali materi dan coba pahami alasan jawabannya.';

/* ---------- navigasi ---------- */
function renderSteps(){
  var ol=$('#steps');ol.innerHTML='';
  STEPS.forEach(function(s){
    var li=document.createElement('li');var b=document.createElement('button');
    b.className='step'+(cur===s[0]?' cur':'')+(done[s[0]]?' done':'');
    b.setAttribute('data-go',s[0]);
    if(cur===s[0])b.setAttribute('aria-current','step');
    b.innerHTML='<b><span>'+s[2]+'</span></b><span class="step-label">'+s[1]+(done[s[0]]?' (selesai)':'')+'</span>';
    li.appendChild(b);ol.appendChild(li);
  });
  var n=Object.keys(done).filter(function(k){return done[k]}).length;
  var mc=$('#missionCount');if(mc)mc.textContent='Misi selesai '+n+' dari 5';
  var left=Object.keys(done).filter(function(k){return !done[k]});
  var sb=$('#startQuiz'),lk=$('#quizLock');
  if(sb)sb.disabled=left.length>0;
  if(lk){
    lk.hidden=left.length===0;
    lk.innerHTML='<span class="ic">🔒</span><div><p><b>Kuis masih terkunci.</b> Selesaikan aktivitas pada misi berikut agar kuis terbuka:</p><div class="after">'+left.map(function(k){return '<button class="btn alt sm" type="button" data-go="'+k+'">Misi '+k.slice(5)+'</button>'}).join('')+'</div></div>';
  }
  var v=$('#video5');
  if(v){
    var open=n===5;
    v.classList.toggle('locked',!open);
    $('#vlink').hidden=!open;
    $('#vstat').textContent=open?'Terbuka':'Terkunci ('+n+' dari 5 misi)';
    $('#vtext').textContent=open?'Semua misi selesai! Dengarkan penjelasan ulang lewat video berikut sebelum mengerjakan evaluasi. Video terbuka di tab baru.':'Selesaikan Misi 1 sampai 5 untuk membuka video penjelasan ulang.';
  }
}
function show(id){
  if(PAGES.indexOf(id)<0)id='beranda';
  if(id==='hasil'&&!quiz.finished)id='evaluasi';
  cur=id;
  PAGES.forEach(function(p){$('#p-'+p).hidden=(p!==id)});
  if(id==='hasil')renderResult();
  if(id==='evaluasi')syncQuiz();
  renderSteps();
  if(window.speechSynthesis)try{speechSynthesis.cancel()}catch(e){}
  window.scrollTo(0,0);
  var h=$('#p-'+id+' h2[tabindex]');if(h)h.focus({preventScroll:true});
}
function go(id){ if(location.hash==='#'+id)show(id); else location.hash=id; }
window.addEventListener('hashchange',function(){show(location.hash.slice(1)||'beranda')});
document.addEventListener('click',function(e){
  var t=e.target.closest('[data-go]');if(t){go(t.getAttribute('data-go'))}
});
function markDone(id){ if(!done[id]){done[id]=true;renderSteps();} }

/* ---------- narasi (opsional, bila perangkat mendukung) ---------- */
(function(){
  var ok='speechSynthesis' in window&&'SpeechSynthesisUtterance' in window;
  document.querySelectorAll('.say').forEach(function(b){
    if(!ok){b.hidden=true;return}
    b.addEventListener('click',function(){
      try{
        if(speechSynthesis.speaking){speechSynthesis.cancel();b.textContent='🔊 Dengarkan';return}
        var u=new SpeechSynthesisUtterance(b.closest('[data-say]').getAttribute('data-say'));
        u.lang='id-ID';u.onend=function(){b.textContent='🔊 Dengarkan'};
        b.textContent='⏹ Berhenti';speechSynthesis.speak(u);
      }catch(e){b.hidden=true}
    });
  });
})();

/* ---------- pembuat soal pilihan ganda ---------- */
function esc(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;')}
function buildMCQ(o){
  var wrap=document.createElement('div');
  var html='';
  if(o.passage)html+='<div class="passage">'+(o.title?'<div class="ttl">'+esc(o.title)+'</div>':'')+'<p style="margin:0">'+o.passage+'</p></div>';
  html+='<p class="q">'+o.question+'</p><div class="opts"></div><div class="fbhost" aria-live="polite"></div>';
  wrap.innerHTML=html;
  var box=$('.opts',wrap),host=$('.fbhost',wrap);
  var L=['A','B','C','D'];
  o.options.forEach(function(t,i){
    var b=document.createElement('button');b.type='button';b.className='opt'+(o.sentences?' sent':'');
    b.innerHTML=(o.sentences?'<span class="num">'+(i+1)+'</span>':'<span class="let">'+L[i]+'</span>')+'<span>'+esc(t)+'</span>';
    b.addEventListener('click',function(){
      box.classList.add('locked');
      var ok=i===o.correct;
      b.classList.add(ok?'ok':'no');
      if(!ok)box.children[o.correct].classList.add('ok');
