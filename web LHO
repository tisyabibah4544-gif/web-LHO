      if(o.onAnswer)o.onAnswer(ok,i,wrap);
    });
    box.appendChild(b);
  });
  return wrap;
}
function rounds(host,list,scoreEl,missionId,label){
  var i=0,right=0;
  function step(){
    host.innerHTML='';
    var d=list[i];
    var head=document.createElement('p');head.className='tag';head.textContent=label+' '+(i+1)+' dari '+list.length;
    host.appendChild(head);
    var m=buildMCQ(Object.assign({},d,{onAnswer:function(ok,_,w){
      if(ok)right++;
      scoreEl.textContent='Benar '+right+' dari '+list.length;
      var a=document.createElement('div');a.className='after';
      var b=document.createElement('button');b.className='btn';b.type='button';
      if(i<list.length-1){b.textContent=label+' berikutnya →';b.onclick=function(){i++;step()}}
      else{b.textContent='Lihat ringkasan';b.onclick=finish;markDone(missionId)}
      a.appendChild(b);w.appendChild(a);b.focus({preventScroll:false});
    }}));
    host.appendChild(m);
  }
  function finish(){
    host.innerHTML='<div class="summary"><div class="big">'+right+' / '+list.length+'</div><p>'+(right===list.length?'Sempurna! Kamu sudah mahir pada misi ini.':'Kamu menjawab '+right+' dari '+list.length+' dengan benar. Baca ulang materi lalu coba lagi untuk memperkuat pemahamanmu.')+'</p><button class="btn alt" type="button">Main lagi</button></div>';
    $('button',host).onclick=function(){i=0;right=0;scoreEl.textContent='Benar 0 dari '+list.length;step()};
  }
  step();
}

