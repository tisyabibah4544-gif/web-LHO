function resetQuiz(){quiz={started:false,i:0,answers:[],finished:false}}
function syncQuiz(){
  $('#quizIntro').hidden=quiz.started;
  $('#quizBody').hidden=!quiz.started;
  $('#evalNav .right').innerHTML='';
  if(quiz.started&&!quiz.finished)drawQ();
}
function score(){return quiz.answers.filter(function(a,i){return a===Q[i].a}).length*10}
function drawQ(){
  var i=quiz.i,d=Q[i],body=$('#quizBody');
  body.innerHTML='<div class="qmeta"><span>Soal '+(i+1)+' dari 10</span><span class="badge">Skor sementara '+score()+'</span></div>'+
    '<div class="prog" role="progressbar" aria-valuemin="0" aria-valuemax="10" aria-valuenow="'+i+'"><i style="width:'+(i*10)+'%"></i></div><div class="act" style="margin-top:0" id="qhost"></div>';
  $('#qhost').appendChild(buildMCQ({title:d.title,passage:esc(d.p),question:d.q,options:d.o,correct:d.a,explain:d.e,
    onAnswer:function(ok,pick,w){
      quiz.answers[i]=pick;
      $('.qmeta .badge',body).textContent='Skor sementara '+score();
      var a=document.createElement('div');a.className='after';
      var b=document.createElement('button');b.className='btn';b.type='button';
      b.textContent=i<9?'Soal berikutnya →':'Lihat hasil →';
      b.onclick=function(){ if(i<9){quiz.i++;drawQ();window.scrollTo(0,0)} else {quiz.finished=true;go('hasil')} };
      a.appendChild(b);w.appendChild(a);b.focus();
    }}));
}
function startQuiz(){
  if(Object.keys(done).some(function(k){return !done[k]}))return;
  resetQuiz();quiz.started=true;syncQuiz();window.scrollTo(0,0)}
$('#startQuiz').addEventListener('click',startQuiz);
