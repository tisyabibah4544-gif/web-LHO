<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<style>body{margin:0}img{max-width:100%}[hidden]{display:none!important}</style>
<title>LHO Quest</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&display=swap" rel="stylesheet">
<style>
/* Konsep tata letak: buku catatan lapangan. Bilah progres di atas, satu misi per layar, kartu putih di atas latar abu terang.
   Palet mengikuti ketentuan: 60% #FFF8E1, 30% #1F4D38, 10% #F4C430. Tampilan tunggal (terang) dipilih sengaja. */
:root{
  --bg:#F5EFDB; --card:#FFFFFF; --fg:#1B2E24; --ink:#1F4D38; --ink-soft:#56685C;
  --gold:#F4C430; --on-gold:#2A2200; --line:#D8D2B8; --tint:#E4EDDD; --gold-tint:rgba(244,196,48,.3);
  --bad:#B4432F; --bad-tint:#F8DDD6; --hero-bg:#1F4D38; --hero-ink:#FFF6DA;
  --m-topik:#BFE0E6; --m-utama:#FBE48A; --m-gagasan:#F7CFAE; --m-penjelas:#CFE3C4;
  --display:'Bricolage Grotesque','Trebuchet MS',system-ui,sans-serif;
  --body:'Atkinson Hyperlegible','Segoe UI',system-ui,sans-serif;
  color-scheme:light;
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --bg:#12201A; --card:#1B2E25; --fg:#EDF2E4; --ink:#86C29B; --ink-soft:#A9BAAC;
    --line:#35493D; --tint:#233A2D; --gold-tint:rgba(244,196,48,.22);
    --bad:#F2937F; --bad-tint:#4A2A24; --hero-bg:#0E2A1D;
    --m-topik:#2D5560; --m-utama:#6B5A12; --m-gagasan:#6B4728; --m-penjelas:#34553E;
    color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#12201A; --card:#1B2E25; --fg:#EDF2E4; --ink:#86C29B; --ink-soft:#A9BAAC;
  --line:#35493D; --tint:#233A2D; --gold-tint:rgba(244,196,48,.22);
  --bad:#F2937F; --bad-tint:#4A2A24; --hero-bg:#0E2A1D;
  --m-topik:#2D5560; --m-utama:#6B5A12; --m-gagasan:#6B4728; --m-penjelas:#34553E;
  color-scheme:dark;
}
*{box-sizing:border-box}
body{background:var(--bg);color:var(--fg);font-family:var(--body);font-size:17px;line-height:1.6;
  padding-block:0 48px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:30;background:var(--bg)}
.wrap{max-width:980px;margin:0 auto}
h1,h2,h3{font-family:var(--display);line-height:1.1;margin:0;text-wrap:balance}
h2{font-size:clamp(1.7rem,4.2vw,2.5rem);font-weight:800;letter-spacing:-.01em}
h3{font-size:1.2rem;font-weight:700}
p{margin:0 0 .8em}
ul,ol{margin:0;padding-left:1.2em}
li+li{margin-top:.35em}
button{font:inherit;color:inherit}
:focus-visible{outline:3px solid var(--gold);outline-offset:2px}
h2:focus{outline:none}

/* top bar */
.topbar{position:sticky;top:env(safe-area-inset-top,0px);z-index:20;background:var(--bg);border-bottom:1px solid var(--line);margin-inline:-16px;padding:10px 16px}
.topbar .wrap{display:flex;align-items:center;gap:14px;flex-wrap:wrap;justify-content:space-between}
.brand{display:flex;align-items:center;gap:10px;background:none;border:0;cursor:pointer;padding:4px 0;font-family:var(--display);font-weight:800;font-size:1.05rem;letter-spacing:.06em}
.brand i{display:inline-block;width:12px;height:12px;background:var(--gold);border-radius:50%}
.steps{display:flex;gap:6px;flex-wrap:wrap;list-style:none;padding:0;margin:0}
.steps li{margin:0}
.step{display:flex;align-items:center;gap:7px;padding:4px 10px 4px 5px;border-radius:999px;border:1.5px solid var(--line);background:transparent;cursor:pointer;font-size:.88rem;font-weight:700}
.step b{display:grid;place-items:center;width:24px;height:24px;border-radius:50%;background:var(--tint);font-size:.8rem}
.step.cur{border-color:var(--ink);background:var(--card)}
.step.done b{background:var(--gold);color:var(--on-gold)}
.step.done b::before{content:"✓"}
.step.done b span{display:none}
.step-label{white-space:nowrap}
@media (max-width:640px){.step{padding:3px}.step-label{display:none}}

/* generic */
.page{padding-block:32px 8px}
.eyebrow{font-size:.8rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;display:flex;align-items:center;gap:10px;margin-bottom:12px}
.eyebrow .n{display:grid;place-items:center;min-width:30px;height:30px;border-radius:50%;background:var(--gold);color:var(--on-gold);letter-spacing:0}
.lead{font-size:1.1rem;color:var(--ink-soft);max-width:62ch}
.card{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:20px}
.card h3{margin-bottom:10px}
.grid2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
.grid3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
@media (max-width:760px){.grid2,.grid3{grid-template-columns:minmax(0,1fr)}}
.stack{display:grid;gap:16px;margin-top:24px}
.mark{background:var(--gold);color:var(--on-gold);padding:0 .32em;border-radius:3px;font-weight:700;-webkit-box-decoration-break:clone;box-decoration-break:clone}
.mark.t{background:var(--m-topik);color:var(--fg)}
.mark.gu{background:var(--m-gagasan);color:var(--fg)}
.mark.gp{background:var(--m-penjelas);color:var(--fg)}
.mark.ku{background:var(--m-utama);color:var(--fg)}
.tag{display:inline-block;font-size:.75rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-soft);margin-bottom:8px}
.btn{display:inline-flex;align-items:center;gap:8px;padding:12px 22px;border-radius:8px;border:2px solid var(--ink);background:var(--ink);color:var(--bg);font-weight:700;cursor:pointer;text-decoration:none}
.btn:hover{filter:brightness(1.12)}
.btn.accent{background:var(--gold);border-color:var(--gold);color:var(--on-gold)}
.btn.alt{background:transparent;color:var(--ink)}
.btn.alt:hover{background:var(--tint)}
.btn.sm{padding:7px 14px;font-size:.9rem}
.btn:disabled{opacity:.45;cursor:not-allowed;filter:none}
.nav{display:flex;gap:12px;flex-wrap:wrap;justify-content:space-between;margin-top:32px;padding-top:20px;border-top:1px solid var(--line)}
.nav .right{margin-left:auto;display:flex;gap:12px;flex-wrap:wrap}
.say{float:right;margin:0 0 6px 12px}
.say[hidden]{display:none}
.rule{border:0;border-top:1px solid var(--line);margin:0}

/* hero */
.hero{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1fr);gap:32px;align-items:center;background:var(--hero-bg);color:var(--hero-ink);border-radius:24px;padding:clamp(20px,4vw,40px)}
.hero>*{min-width:0}
@media (max-width:820px){.hero{grid-template-columns:minmax(0,1fr)}}
.hero h1{font-size:clamp(3.2rem,11vw,6rem);font-weight:800;letter-spacing:-.02em;line-height:.95}
.hero h1 em{font-style:normal;color:var(--gold)}
.hero .sub{font-family:var(--display);font-size:clamp(1.15rem,2.6vw,1.5rem);font-weight:500;margin:16px 0}
.slogan{display:flex;gap:8px;flex-wrap:wrap;margin:0 0 24px;list-style:none;padding:0}
.slogan li{margin:0;padding:5px 12px;border:1.5px solid var(--hero-ink);border-radius:999px;font-weight:700;font-size:.95rem}
.ill{width:100%;height:auto;display:block;border-radius:12px}
.map{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:10px;margin-top:40px;list-style:none;padding:0}
.map li{margin:0;background:var(--card);border:1px solid var(--line);border-radius:8px;padding:12px;font-size:.88rem;line-height:1.35}
.map b{display:block;font-family:var(--display);font-size:.78rem;letter-spacing:.1em;text-transform:uppercase;margin-bottom:4px;color:var(--ink-soft)}
@media (max-width:820px){.map{grid-template-columns:repeat(2,minmax(0,1fr))}}

/* instructions */
.howto{list-style:none;padding:0;display:grid;gap:12px;margin-top:24px;counter-reset:h}
.howto li{margin:0;display:flex;gap:14px;align-items:flex-start;background:var(--card);border:1px solid var(--line);border-radius:10px;padding:14px 16px;counter-increment:h}
.howto li::before{content:counter(h);flex:none;display:grid;place-items:center;width:32px;height:32px;border-radius:50%;background:var(--gold);color:var(--on-gold);font-weight:700;font-family:var(--display)}

/* goals */
.goals{list-style:none;padding:0;display:grid;gap:12px;margin-top:24px}
.goals li{margin:0;display:grid;grid-template-columns:auto 1fr;gap:14px;background:var(--card);border:1px solid var(--line);border-radius:10px;padding:16px}
.goals .k{font-family:var(--display);font-weight:800;font-size:1.6rem;color:var(--ink);line-height:1}
.goals .k span{background:var(--gold);color:var(--on-gold);padding:0 .2em;border-radius:3px}

/* material visuals */
.exfeat{display:flex;align-items:center;gap:14px;flex-wrap:wrap}
.exbox{padding:10px 14px;border-radius:8px;border:1.5px dashed var(--ink);background:var(--card)}
.arrow{font-family:var(--display);font-size:1.5rem;font-weight:800}
.cmp{width:100%;border-collapse:collapse;background:var(--card);border-radius:10px;overflow:hidden}
.cmp th,.cmp td{text-align:left;padding:12px 14px;border-bottom:1px solid var(--line);vertical-align:top}
.cmp thead th{background:var(--ink);color:var(--bg);font-family:var(--display);letter-spacing:.04em}
.cmp tbody th{width:30%;font-family:var(--display)}
.cmp tr:last-child th,.cmp tr:last-child td{border-bottom:0}
.tablebox{overflow-x:auto;border:1px solid var(--line);border-radius:10px}
.tree .root{display:inline-block;background:var(--ink);color:var(--bg);padding:12px 16px;border-radius:8px;font-weight:700;max-width:100%}
.tree .root small{display:block;font-size:.72rem;letter-spacing:.12em;text-transform:uppercase;opacity:.8;margin-bottom:2px}
.branches{margin:0 0 0 22px;padding:14px 0 0 22px;border-left:3px solid var(--ink);display:grid;gap:10px;list-style:none}
.branches li{margin:0;position:relative;background:var(--card);border:1.5px solid var(--ink);border-radius:8px;padding:10px 14px}
.branches li::before{content:"";position:absolute;left:-25px;top:50%;width:22px;border-top:3px solid var(--ink)}
.branches li small{display:block;font-size:.72rem;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-soft)}
.pos{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
@media (max-width:760px){.pos{grid-template-columns:minmax(0,1fr)}}
.pos .card{padding:14px}
.pos .s{display:block;padding:4px 8px;border-radius:5px;background:var(--tint);margin-bottom:5px;font-size:.88rem}
.pos .s.m{background:var(--m-utama);font-weight:700}

/* activities */
.act{margin-top:28px;background:var(--card);border:2px solid var(--ink);border-radius:12px;padding:22px}
.act-head{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;align-items:center;margin-bottom:14px}
.act-head h3{display:flex;align-items:center;gap:10px}
.badge{display:inline-flex;align-items:center;gap:6px;background:var(--gold);color:var(--on-gold);font-weight:700;border-radius:999px;padding:3px 12px;font-size:.88rem;font-variant-numeric:tabular-nums}
.passage{background:var(--tint);border-radius:8px;padding:14px 16px;margin-bottom:14px}
.passage .ttl{font-family:var(--display);font-weight:700;margin-bottom:4px}
.q{font-weight:700;margin:0 0 12px}
.opts{display:grid;gap:10px}
.opt{display:flex;gap:12px;align-items:flex-start;text-align:left;width:100%;padding:12px 14px;border:1.5px solid var(--line);background:var(--card);border-radius:8px;cursor:pointer}
.opt:hover{border-color:var(--ink)}
.opt .let{flex:none;display:grid;place-items:center;width:28px;height:28px;border-radius:50%;background:var(--tint);font-weight:700;font-size:.9rem}
.opts.locked .opt{pointer-events:none}
.opt.ok{background:var(--ink);border-color:var(--ink);color:var(--bg)}
.opt.ok .let{background:var(--gold);color:var(--on-gold)}
.opt.no{border-color:var(--bad);background:var(--bad-tint)}
.opt.no .let{background:var(--bad);color:var(--bg)}
.fb{display:flex;gap:12px;align-items:flex-start;margin-top:14px;padding:14px;border-radius:8px}
.fb .ic{flex:none;display:grid;place-items:center;width:28px;height:28px;border-radius:50%;font-weight:700;color:var(--bg)}
.fb.ok{background:var(--tint)} .fb.ok .ic{background:var(--ink)}
.fb.no{background:var(--bad-tint)} .fb.no .ic{background:var(--bad)}
.fb p{margin:0}.fb p+p{margin-top:.4em}
.after{display:flex;gap:10px;flex-wrap:wrap;margin-top:14px}
.sentopt .num{flex:none;display:grid;place-items:center;width:28px;height:28px;border-radius:6px;background:var(--tint);font-weight:700;font-size:.9rem}
.opt.sent{align-items:flex-start}
.opt.ok .num{background:var(--gold);color:var(--on-gold)}
.opt.no .num{background:var(--bad);color:var(--bg)}
.summary{text-align:center;padding:10px 0}
.summary .big{font-family:var(--display);font-size:2.4rem;font-weight:800}

/* pair game */
.pairs{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
@media (max-width:760px){.pairs{grid-template-columns:minmax(0,1fr)}}
.pbox{border:2px solid var(--ink);border-radius:10px;overflow:hidden;background:var(--card)}
.pbtn{width:100%;text-align:left;background:var(--ink);color:var(--bg);border:0;padding:12px 14px;cursor:pointer;font-weight:700}
.pbtn small{display:block;font-size:.72rem;letter-spacing:.12em;text-transform:uppercase;opacity:.8}
.pbtn:hover{filter:brightness(1.12)}
.pbox ul{list-style:none;padding:10px;margin:0;display:grid;gap:8px;min-height:64px}
.pbox li{margin:0;padding:8px 12px;background:var(--gold-tint);border-radius:6px;font-size:.95rem}
.pbox li::before{content:"✓ ";font-weight:700}
.chips{display:flex;flex-wrap:wrap;gap:10px;margin-top:16px}
.chip{padding:9px 14px;border-radius:8px;border:1.5px solid var(--ink);background:var(--card);cursor:pointer;text-align:left}
.chip[aria-pressed="true"]{background:var(--gold);color:var(--on-gold)}
.shake{animation:shake .35s}
@keyframes shake{25%{transform:translateX(-5px)}75%{transform:translateX(5px)}}
@media (prefers-reduced-motion:reduce){.shake{animation:none}}

/* explorer (misi 5) */
.seg{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px}
.seg button{padding:8px 14px;border-radius:999px;border:1.5px solid var(--ink);background:var(--card);cursor:pointer;font-weight:700}
.seg button[aria-pressed="true"]{background:var(--ink);color:var(--bg)}
.seg button.seen::after{content:" ✓";color:var(--gold)}
.seg button[aria-pressed="true"].seen::after{color:var(--gold)}
.sample .ttl{font-family:var(--display);font-weight:700;font-size:1.2rem;display:inline-block;padding:0 .2em;border-radius:4px;margin-bottom:6px}
.sample .snt{padding:2px 4px;border-radius:4px;transition:background .2s}
.sample .hl-topik{background:var(--m-topik);font-weight:700}
.sample .hl-utama{background:var(--m-utama);font-weight:700}
.sample .hl-gagasan{background:var(--m-gagasan);font-weight:700}
.sample .hl-penjelas{background:var(--m-penjelas)}
.expl{margin-top:14px;min-height:3.2em}

.video{background:var(--gold-tint);border-color:var(--ink)}
.video .btn{margin-top:4px}
.video.locked{background:var(--tint);border-style:dashed}
/* quiz */
.prog{height:8px;background:var(--tint);border-radius:99px;overflow:hidden;margin-bottom:14px}
.prog i{display:block;height:100%;background:var(--ink);transition:width .3s}
.qmeta{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;align-items:center;margin-bottom:12px;font-weight:700}
.bignum{font-family:var(--display);font-weight:800;font-size:clamp(4rem,14vw,7rem);line-height:1;font-variant-numeric:tabular-nums}
.bignum small{font-size:.3em;color:var(--ink-soft);font-weight:500}
.res{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.2fr);gap:20px;align-items:start}
@media (max-width:760px){.res{grid-template-columns:minmax(0,1fr)}}
.stat{display:flex;gap:12px;flex-wrap:wrap;margin-top:12px}
.stat div{flex:1;min-width:110px;background:var(--tint);border-radius:8px;padding:10px 14px}
.stat b{display:block;font-family:var(--display);font-size:1.6rem}
.dots{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}
.dots span{display:grid;place-items:center;width:32px;height:32px;border-radius:6px;font-weight:700;font-size:.85rem}
.dots .y{background:var(--ink);color:var(--bg)}
.dots .n{background:var(--bad-tint);color:var(--bad);border:1.5px solid var(--bad)}
.skill{display:flex;justify-content:space-between;gap:10px;align-items:center;flex-wrap:wrap;padding:10px 0;border-bottom:1px solid var(--line)}
.skill:last-child{border-bottom:0}
</style>

</head>
<body>
<header class="topbar" id="topbar">
  <div class="wrap">
    <button class="brand" data-go="beranda" aria-label="Kembali ke Beranda"><i></i>LHO QUEST</button>
    <ol class="steps" id="steps" aria-label="Progres misi"></ol>
  </div>
</header>

<main class="wrap">

<!-- HALAMAN 1: BERANDA -->
<section class="page" id="p-beranda">
  <div class="hero">
    <div>
      <div class="eyebrow">Bahasa Indonesia · Kelas VIII SMP</div>
      <h1>LHO <em>QUEST</em></h1>
      <p class="sub">Petualangan Memahami Teks Laporan Hasil Observasi</p>
      <ul class="slogan" aria-label="Slogan"><li>Amati,</li><li>Pahami,</li><li>Laporkan!</li></ul>
      <button class="btn accent" data-go="petunjuk">Mulai Petualangan →</button>
    </div>
    <svg class="ill" viewBox="0 0 480 360" role="img" aria-label="Ilustrasi siswa mengamati tanaman dengan kaca pembesar sambil membawa buku catatan">
      <rect width="480" height="360" rx="14" fill="#E4EDDD"/>
      <circle cx="396" cy="72" r="30" fill="#F4C430"/>
      <path d="M0 270 Q110 205 230 255 T480 240 V360 H0Z" fill="#1F4D38" fill-opacity=".16"/>
      <rect x="40" y="178" width="12" height="92" fill="#1F4D38"/>
      <circle cx="46" cy="160" r="44" fill="#1F4D38" fill-opacity=".85"/>
      <circle cx="26" cy="176" r="24" fill="#1F4D38" fill-opacity=".85"/>
      <rect x="0" y="292" width="480" height="68" fill="#1F4D38"/>
      <g stroke="#FFF8E1" stroke-width="3" fill="none" stroke-linecap="round"><path d="M360 292 V240"/><path d="M360 262 Q335 258 330 238"/><path d="M360 252 Q388 246 392 226"/></g>
      <g fill="#FFF8E1"><ellipse cx="330" cy="232" rx="9" ry="14" transform="rotate(-25 330 232)"/><ellipse cx="393" cy="220" rx="9" ry="14" transform="rotate(25 393 220)"/><ellipse cx="360" cy="232" rx="9" ry="14"/></g>
      <!-- siswa -->
      <circle cx="196" cy="140" r="24" fill="#FFF8E1" stroke="#1F4D38" stroke-width="5"/>
      <path d="M172 136 Q176 110 198 112 Q220 112 220 136 Q205 122 172 136Z" fill="#1F4D38"/>
      <rect x="170" y="170" width="52" height="84" rx="14" fill="#1F4D38"/>
      <rect x="176" y="250" width="16" height="42" rx="6" fill="#1F4D38"/>
      <rect x="200" y="250" width="16" height="42" rx="6" fill="#1F4D38"/>
      <path d="M216 190 L256 226" stroke="#1F4D38" stroke-width="12" stroke-linecap="round"/>
      <circle cx="288" cy="204" r="30" fill="#FFF8E1" fill-opacity=".9" stroke="#F4C430" stroke-width="7"/>
      <path d="M278 214 Q288 190 300 196 Q298 212 278 214Z" fill="#1F4D38"/>
      <path d="M266 226 L250 242" stroke="#F4C430" stroke-width="9" stroke-linecap="round"/>
      <path d="M172 192 L152 218" stroke="#1F4D38" stroke-width="12" stroke-linecap="round"/>
      <rect x="120" y="206" width="40" height="52" rx="4" fill="#FFF8E1" stroke="#1F4D38" stroke-width="4" transform="rotate(-8 140 232)"/>
      <g stroke="#1F4D38" stroke-width="3" stroke-linecap="round" transform="rotate(-8 140 232)"><path d="M128 220H150"/><path d="M128 230H150"/><path d="M128 240H142"/></g>
    </svg>
  </div>
  <h2 style="font-size:1.1rem;margin-top:44px;letter-spacing:.1em;text-transform:uppercase">Peta petualangan</h2>
  <ol class="map" aria-label="Daftar misi">
    <li><b>Misi 1</b>Mengenal topik</li>
